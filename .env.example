# Public browser-safe Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Paystack public key (never expose the secret key)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxx

# Cloudinary unsigned upload configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=gailand_unsigned

# Change before production. Prefer server-side authentication for production.
NEXT_PUBLIC_ADMIN_PASSWORD=gailand2026admin
