# Public browser-safe Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Paystack public key (never expose the secret key)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxx
# Server-only Paystack verification key
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx

# Server-only Supabase key used after payment verification
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary unsigned upload configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=gerland_products
NEXT_PUBLIC_CLOUDINARY_ASSET_FOLDER=gerland_products

# Server-only Cloudinary cleanup credentials. Never prefix these with NEXT_PUBLIC_.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
